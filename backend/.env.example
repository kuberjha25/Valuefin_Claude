# ---------------------------------------------------------------------------
# Valuefin Desk — backend configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# --- MySQL -----------------------------------------------------------------
# Always wrap passwords in double quotes: an unquoted `#` starts a comment.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=valuefin_app
DB_PASSWORD=change-me
DB_NAME=valuefin
DB_POOL_SIZE=10

# --- Security --------------------------------------------------------------
# Session lifetime in hours; bcrypt work factor for password hashing.
SESSION_TTL_HOURS=12
BCRYPT_ROUNDS=12

# Passwords assigned to the three seeded accounts on first migration only.
# Changing these later has no effect — use Team → Reset password in the app.
SEED_DIRECTOR_PASSWORD=change-me
SEED_MANAGER_PASSWORD=change-me
SEED_ANALYST_PASSWORD=change-me
